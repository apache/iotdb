# Copy this file to config.env and adjust the CLI path before running.
CLI_BIN=/absolute/path/to/iotdb/sbin/start-cli.sh
HOST=127.0.0.1
PORT=6667
USERNAME=root
PASSWORD=root

# The filesystem view currently uses the table dialect in this benchmark.
SQL_DIALECT=table
DATABASE=cli_benchmark
TABLE=telemetry
WRITE_TABLE=telemetry_write

# Workload size. A small default keeps the first run quick; increase POINTS
# and QUERY_LIMIT for a production-like run.
DEVICES=4
POINTS_PER_DEVICE=1000
BATCH_SIZE=200
QUERY_LIMIT=100
WARMUP=2
REPEAT=5
TIMEOUT_SECONDS=120
OUTPUT_DIR=results

# Set INCLUDE_WRITE=true only after enabling filesystem writes. The write case
# compares SQL INSERT with filesystem tee and appends to WRITE_TABLE.
INCLUDE_WRITE=false
