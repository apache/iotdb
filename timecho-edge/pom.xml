<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>iotdb-parent</artifactId>
        <groupId>org.apache.iotdb</groupId>
        <version>2.0.11-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.timecho.iotdb</groupId>
    <artifactId>timecho-edge</artifactId>
    <name>TimechoDB: Edge</name>
    <properties>
        <iotdb.it.skip>${iotdb.test.skip}</iotdb.it.skip>
        <iotdb.test.skip>false</iotdb.test.skip>
        <iotdb.ut.skip>${iotdb.test.skip}</iotdb.ut.skip>
    </properties>
    <dependencies>
        <!-- The Edge entry point starts the TimechoDB ConfigNode and DataNode bootstraps inside
             ONE JVM; it needs both node implementations, and lives in its own module so that
             timecho-confignode does not have to depend on timecho-server. The apache orchestration
             (org.apache.iotdb.edge.EdgeNode) is referenced directly, hence the explicit
             iotdb-confignode dependency. -->
        <dependency>
            <groupId>com.timecho.iotdb</groupId>
            <artifactId>timecho-confignode</artifactId>
            <version>2.0.11-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iotdb</groupId>
            <artifactId>iotdb-confignode</artifactId>
            <version>2.0.11-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.timecho.iotdb</groupId>
            <artifactId>timecho-server</artifactId>
            <version>2.0.11-SNAPSHOT</version>
        </dependency>
    </dependencies>
</project>
