<assembly>
    <id>mpp-test</id>
    <formats>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <!-- The default file-system provider must be loadable before the JVM opens application JARs. -->
        <fileSet>
            <outputDirectory>lib/bootstrap</outputDirectory>
            <directory>${maven.multiModuleProjectDirectory}/iotdb-core/node-commons/target/classes</directory>
            <includes>
                <include>com/timecho/iotdb/commons/file/**</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../iotdb-core/datanode/src/assembly/resources/conf</directory>
        </fileSet>
        <fileSet>
            <directory>${maven.multiModuleProjectDirectory}/timecho-server/src/main/resources</directory>
            <outputDirectory>conf</outputDirectory>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../iotdb-core/confignode/src/assembly/resources/conf</directory>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../iotdb-core/node-commons/src/assembly/resources/conf</directory>
            <excludes>
                <exclude>edge/**</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../iotdb-core/metrics/interface/src/main/assembly/resources/conf</directory>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../iotdb-core/ainode/resources/conf</directory>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../scripts/conf</directory>
            <excludes>
                <exclude>iotdb-common.sh</exclude>
                <exclude>**/iotdb-common.bat</exclude>
            </excludes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>conf</outputDirectory>
            <directory>${project.basedir}/../scripts/conf</directory>
            <includes>
                <include>iotdb-common.sh</include>
                <include>windows/iotdb-common.bat</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>sbin</outputDirectory>
            <directory>${project.basedir}/../scripts/sbin</directory>
            <excludes>
                <exclude>start-datanode.sh</exclude>
                <exclude>start-confignode.sh</exclude>
                <exclude>windows/start-datanode.bat</exclude>
                <exclude>windows/start-confignode.bat</exclude>
            </excludes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- 启动脚本（品牌名随 edition 变化，需要 Maven 过滤 @brand.name@） -->
        <fileSet>
            <outputDirectory>sbin</outputDirectory>
            <directory>${project.basedir}/../scripts/sbin</directory>
            <includes>
                <include>start-datanode.sh</include>
                <include>start-confignode.sh</include>
                <include>windows/start-datanode.bat</include>
                <include>windows/start-confignode.bat</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>tools</outputDirectory>
            <directory>${project.basedir}/../scripts/tools</directory>
            <excludes>
                <exclude>ops/daemon-datanode.sh</exclude>
                <exclude>ops/daemon-confignode.sh</exclude>
                <exclude>ops/daemon-ainode.sh</exclude>
            </excludes>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- 工具脚本（品牌名与 systemd 单元名随 edition 变化，需要 Maven 过滤 @brand.name@ / @package.name@） -->
        <fileSet>
            <outputDirectory>tools</outputDirectory>
            <directory>${project.basedir}/../scripts/tools</directory>
            <includes>
                <include>ops/daemon-datanode.sh</include>
                <include>ops/daemon-confignode.sh</include>
                <include>ops/daemon-ainode.sh</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <outputDirectory>lib</outputDirectory>
            <directory>${project.basedir}/../iotdb-core/ainode/dist/ainode/</directory>
            <fileMode>0755</fileMode>
        </fileSet>
    </fileSets>
</assembly>
